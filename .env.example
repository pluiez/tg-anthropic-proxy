# Client uses BOT_A_TOKEN; Server uses BOT_B_TOKEN.
# Both machines must use the same BRIDGE_CHAT_ID for the shared Telegram group.
BOT_A_TOKEN=
BOT_B_TOKEN=
BRIDGE_CHAT_ID=

# Real Anthropic-compatible upstream endpoint.
# - server uses this directly in normal mode.
# - cc_proxy uses this as its upstream when `server --use-cc-proxy` is enabled.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional cc_proxy sidecar.
# To enable it, run `python -m cc_proxy.main`, then run the server with
# `python -m server.main --use-cc-proxy`. ANTHROPIC_BASE_URL remains the
# real upstream endpoint and cc_proxy forwards to it.
CC_PROXY_HOST=127.0.0.1
CC_PROXY_PORT=8790
CC_PROXY_CLAUDE_CODE_VERSION=1.0.0
CC_PROXY_CLAUDE_CODE_USER_AGENT=

# Client-only HTTP listener.
PROXY_HOST=127.0.0.1
PROXY_PORT=8787

# Client wait timeout for response frames coming back through Telegram.
# This is not the Telegram send timeout.
PROXY_RESPONSE_TIMEOUT=180

# Max characters for one Telegram text frame.
# This is a Telegram message size limit after JSON framing + gzip + base64.
# It is used for request text frames and as the default response frame limit
# unless PROXY_TELEGRAM_RESPONSE_FRAME_MAX_CHARS is set below.
PROXY_TELEGRAM_FRAME_MAX_CHARS=4000

# Request transport decision:
# 1. client builds the request envelope, applying cache refs if available.
# 2. client estimates how many Telegram text frames that envelope would need,
#    using PROXY_TELEGRAM_FRAME_MAX_CHARS.
# 3. if the estimated frame count is >= this threshold, client sends one gzip
#    Telegram document instead of text frames. Document requests are complete
#    by themselves and do not send a trailing req_end frame.
# 4. otherwise, client sends N req text frames plus one req_end text frame.
#
# Set 0 to disable document transport. Set 1 to make every request use document
# transport, including small requests.
PROXY_TELEGRAM_DOCUMENT_CHUNK_THRESHOLD=4

# Response bridge coalescing.
# There is currently no response document fallback: response data is sent as
# Telegram text frames only.
#
# Flow:
# upstream SSE raw bytes
#   -> server response buffer
#   -> flush immediately for the first upstream chunk
#   -> after that, flush when interval OR raw-byte threshold is reached
#   -> each flushed batch is gzip+base64 encoded into Telegram text frames
#
# Flush interval in seconds for buffered response bytes after the first chunk.
PROXY_RESPONSE_FLUSH_INTERVAL=2.0

# Flush size threshold for buffered response bytes after the first chunk.
# This is raw upstream SSE bytes before gzip/base64, not compressed size.
PROXY_RESPONSE_FLUSH_BYTES=8192

# Max characters for one response Telegram text frame after JSON framing +
# gzip + base64. This controls how a flushed response batch is split into
# Telegram messages; it does not decide when the response buffer flushes.
# If unset, response frames use PROXY_TELEGRAM_FRAME_MAX_CHARS.
PROXY_TELEGRAM_RESPONSE_FRAME_MAX_CHARS=4000

# Shared Telegram bridge cache. This is in-memory only on both sides.
# It lets repeated Claude Code request fields cross the bridge as small sha256
# refs after the server has cached them. Cache refs reduce the request envelope
# before the request text/document transport decision above.
PROXY_TELEGRAM_CACHE_ENABLED=1

# Cache entries expire after this many seconds. 259200 = 72 hours.
PROXY_TELEGRAM_CACHE_TTL_SECONDS=259200

# Only cache candidate fields whose canonical JSON payload is at least this
# many bytes.
PROXY_TELEGRAM_CACHE_MIN_BYTES=2048

# Candidate request fields to cache. Current supported fields are:
# - tools: whole top-level tools array
# - system: whole top-level system value
# - messages: messages prefixes, e.g. messages[:1], messages[:2], ...
PROXY_TELEGRAM_CACHE_FIELDS=tools,system,messages

# Server-side in-memory cache limits.
PROXY_TELEGRAM_CACHE_MAX_ITEMS=256
PROXY_TELEGRAM_CACHE_MAX_BYTES=33554432

# Client-side known-key table size; server cache limits above still apply.
PROXY_TELEGRAM_CACHE_KNOWN_MAX_ITEMS=1024

# Both.
LOG_LEVEL=INFO
